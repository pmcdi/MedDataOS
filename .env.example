# --agent-url mode: sent to the external agent as the model name, bearer key and
# timeout. The example agent ignores AGENT_MODEL and calls OPENAI_MODEL instead.
AGENT_MODEL=example
AGENT_API_KEY=
AGENT_TIMEOUT=120

# Any OpenAI-compatible model (OpenAI, Ollama, vLLM, ...). Used by the harness
# and the example agent when Azure is not configured.
OPENAI_MODEL=
OPENAI_BASE_URL=
OPENAI_API_KEY=
# OPENAI_REASONING_EFFORT=

# Azure OpenAI, used instead of OPENAI_* when the endpoint and key are set. The
# notes ledger uses it instead of Gemini under the same condition.
# AZURE_OPENAI_API_VERSION is the date Azure expects, such as 2024-10-21.
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-10-21
# Reasoning effort sent with each request, or empty. Some deployments refuse
# function tools on chat completions at any effort (gpt-6.1-sol, 2026-11-18,
# which also rejects none); use HARNESS_MODEL_API=responses for those.
AZURE_OPENAI_REASONING_EFFORT=

# Harness mode (the default: pixi run serve <case>): the server talks to the model
# itself, with the Azure settings when set, otherwise the OPENAI_* settings.
# HARNESS_MODEL_API is chat or responses.
# HARNESS_MODEL_API=chat
# HARNESS_MODEL_TIMEOUT=120
# Retries after a 408, 429, 5xx, dropped connection or timeout (never a 400).
# HARNESS_MODEL_RETRIES=4
# Subagent tables (default ./configs/harness.toml).
# HARNESS_CONFIG=
# MCP registrations, managed with `pixi run mcp` (defaults ~/.meddataos/mcp.json,
# ./configs/mcp.json, ./configs/mcp.local.json).
# HARNESS_MCP_USER=
# HARNESS_MCP_PROJECT=
# HARNESS_MCP_LOCAL=
# Workspaces, the reference index and the notes ledger (default ./.cache/harness).
# HARNESS_CACHE=
# The notes ledger is built when a case opens (one model call per new note,
# then cached). off skips it, and the ledger tools are not offered.
# HARNESS_LEDGER=on
# Sandbox for exec and view_image: off unless docker. The runtime defaults to
# gVisor (runsc); the sandbox refuses to run when Docker lacks it. Sandboxed MCP
# servers (TotalSegmentator) use the same
# runtime, whether or not HARNESS_SANDBOX is on. Without gVisor, name runc
# here knowing it shares the host kernel.
# HARNESS_SANDBOX=docker
# HARNESS_SANDBOX_RUNTIME=runsc
# HARNESS_SANDBOX_IMAGE=debian:bookworm-slim
# HARNESS_SANDBOX_MEMORY=4g
# HARNESS_SANDBOX_CPUS=2
# HARNESS_SANDBOX_TIMEOUT=300

# The notes ledger's model when Azure is not configured. Scanned-PDF OCR in the
# ledger is Gemini only.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.6-flash
# NOTES_EXTRACT_MODEL=
# NOTES_REASON_MODEL=

# Where real cases live for evals and tests (default ./data), and where chats,
# pins, reviews and audit runs are stored (default ./data/cases).
# MEDDATA_CASES=
# MEDDATAOS_STORE=

# Server configuration
HOST=127.0.0.1
PORT=8080
