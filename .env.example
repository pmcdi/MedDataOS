# Sent as the model name on each question. The example agent ignores this
# and calls OPENAI_MODEL instead.
AGENT_MODEL=example
AGENT_API_KEY=
AGENT_TIMEOUT=120

# The model the example agent forwards each question to.
OPENAI_MODEL=
OPENAI_BASE_URL=
OPENAI_API_KEY=

# Azure OpenAI, used instead of OPENAI_* when the key, endpoint, and
# deployment name are all set. The notes specialist uses it instead of Gemini
# under the same condition, and the DICOM specialist always uses it.
# AZURE_OPENAI_API_VERSION is the date Azure expects,
# such as 2024-10-21.
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-10-21
# Set to none for reasoning models that refuse function tools. Otherwise leave empty.
AZURE_OPENAI_REASONING_EFFORT=

# Notes specialist. Used when Azure is not configured.
# Scanned-PDF OCR in notes is Gemini only.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.6-flash
# NOTES_EXTRACT_MODEL=
# NOTES_REASON_MODEL=

# DICOM specialist (OpenAI Agents SDK). Uses the AZURE_OPENAI_* settings above.
# DICOM_AZURE_DEPLOYMENT overrides the deployment; it must accept function tools
# and images. DICOM_API is chat (Chat Completions) or responses (Azure /openai/v1).
# Sandbox work runs inside one request, so raise AGENT_TIMEOUT to about 300.
# DICOM_AZURE_DEPLOYMENT=
# DICOM_API=chat
# DICOM_SANDBOX=local
# DICOM_MAX_TURNS=24

# Where local cases live (default: ./data) and where specialist caches go
# (default: ./.cache/specialists).
# MEDDATA_CASES=
# SPECIALISTS_CACHE=

# Server configuration
HOST=127.0.0.1
PORT=8080
